{
  "name": "runwayml-avatars",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint packages/*/src/",
    "format": "biome check --linter-enabled=false --write packages/*/src/",
    "format:check": "biome check --linter-enabled=false packages/*/src/",
    "test": "bun test",
    "clean": "rm -rf packages/*/dist",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.7",
    "@types/jsdom": "^28.0.1",
    "jsdom": "^29.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
